/* text_input — daisyUI skin.
 *
 * daisyUI's `input` is already a *container*: it paints the border and box, and resets any nested
 * `<input>` to transparent so a leading icon can sit inside the border. That is exactly this
 * component's anatomy, so the root takes `input` and every modifier — `input-primary`, `input-sm`,
 * `input-ghost` — works on the root untouched.
 *
 * What `@apply` cannot carry across is daisyUI's *descendant* rules (`.input input`,
 * `.input:has( > input[disabled])`, `.input > *`), because those match on daisyUI's own class name
 * and our root only borrows its declarations. Those four rules are mirrored below against our
 * parts, and the disabled state is keyed off `data-disabled` — which the component already sets —
 * instead of `:has()`.
 */

.chelekom-text-input {
  @apply <%= @d %>input;
}

.chelekom-text-input__input {
  height: 100%;
  width: 100%;
  appearance: none;
  background-color: transparent;
  border: none;
  position: relative;
  display: inline-flex;
  text-align: start;
  font-size: inherit;
}

.chelekom-text-input__input::placeholder {
  color: var(--color-base-content);
  opacity: 50%;
}

.chelekom-text-input__input:focus,
.chelekom-text-input__input:focus-within {
  --tw-outline-style: none;
  outline-style: none;
}

@media (forced-colors: active) {
  .chelekom-text-input__input:focus,
  .chelekom-text-input__input:focus-within {
    outline: 2px solid transparent;
    outline-offset: 2px;
  }
}

.chelekom-text-input:focus-within {
  --<%= @d %>input-color: var(--color-base-content);
  box-shadow: 0 1px
    color-mix(in oklab, var(--<%= @d %>input-color) calc(var(--depth) * 10%), #0000);
  outline: 2px solid var(--<%= @d %>input-color);
  outline-offset: 2px;
}

.chelekom-text-input[data-disabled] {
  cursor: not-allowed;
  border-color: var(--color-base-200);
  background-color: var(--color-base-200);
  box-shadow: none;
}

.chelekom-text-input[data-disabled] .chelekom-text-input__input {
  cursor: not-allowed;
  color: color-mix(in oklab, var(--color-base-content) 40%, transparent);
}

.chelekom-text-input[data-disabled] .chelekom-text-input__input::placeholder {
  color: var(--color-base-content);
  opacity: 20%;
}

/* An invalid field borrows daisyUI's error color the same way `input-error` would, so the caller
 * does not have to add a modifier class the server already knows to be true. */
.chelekom-text-input[data-invalid] {
  --<%= @d %>input-color: var(--color-error);
}

.chelekom-text-input[data-valid] {
  --<%= @d %>input-color: var(--color-success);
}

/* daisyUI's `.input > *` — a section sits flush against the border and gets a hairline divider. */
.chelekom-text-input__start-section,
.chelekom-text-input__end-section {
  display: flex;
  height: calc(100% - 0.5rem);
  align-items: center;
  padding-inline: calc(0.25rem * 3);
  white-space: nowrap;
  font-size: inherit;
}

.chelekom-text-input__start-section {
  margin-inline-start: calc(0.25rem * -3);
  margin-inline-end: calc(0.25rem * 3);
  border-inline-end: var(--border) solid color-mix(in oklab, currentColor 10%, #0000);
}

.chelekom-text-input__end-section {
  margin-inline-start: calc(0.25rem * 3);
  margin-inline-end: calc(0.25rem * -3);
  border-inline-start: var(--border) solid color-mix(in oklab, currentColor 10%, #0000);
}
