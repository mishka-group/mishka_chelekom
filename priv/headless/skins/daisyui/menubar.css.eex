/* menubar — daisyUI skin.
 *
 * daisyUI has no menubar; it has `menu menu-horizontal` for the bar and `dropdown-content menu`
 * for what drops out of it, which is exactly this component's two halves. Both are borrowed as-is,
 * so the bar and its menus match every other daisyUI menu on the page.
 */

.chelekom-menubar {
  @apply <%= @d %>menu <%= @d %>menu-horizontal;

  padding: calc(0.25rem * 1);
  gap: calc(0.25rem * 1);
}

.chelekom-menubar__trigger {
  border-radius: var(--radius-field);
  padding-inline: calc(0.25rem * 3);
  padding-block: calc(0.25rem * 1.5);
  cursor: pointer;
}

.chelekom-menubar__trigger:hover,
.chelekom-menubar__trigger[aria-expanded="true"] {
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-menubar__popup {
  @apply <%= @d %>menu <%= @d %>dropdown-content;

  position: absolute;
  z-index: 50;
  min-width: 12rem;
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  box-shadow: 0 4px 12px oklch(0% 0 0 / 0.12);
}

.chelekom-menubar__popup[data-closed] {
  display: none;
}
