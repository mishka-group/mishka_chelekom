/* color_input — daisyUI skin.
 *
 * The always-visible half is a daisyUI `input` with a swatch inside it; the picker drops out of it
 * as a `dropdown-content` panel. Same construction as the autocomplete: a familiar field, and a
 * surface that matches every other panel on the page.
 */

.chelekom-color-input {
  position: relative;
  display: inline-block;
}

.chelekom-color-input__control {
  @apply <%= @d %>input;

  display: flex;
  align-items: center;
  gap: calc(0.25rem * 2);
}

.chelekom-color-input__trigger {
  display: inline-flex;
  cursor: pointer;
}

.chelekom-color-input__preview {
  width: calc(0.25rem * 5);
  height: calc(0.25rem * 5);
  border-radius: calc(0.25rem * 1);
  box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.chelekom-color-input__text {
  flex: 1;
  min-width: 5rem;
  border: none;
  background: transparent;
  outline: none;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.chelekom-color-input__panel {
  @apply <%= @d %>dropdown-content;

  position: absolute;
  z-index: 50;
  display: flex;
  flex-direction: column;
  gap: calc(0.25rem * 3);
  width: 15rem;
  margin-top: calc(0.25rem * 1);
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  padding: calc(0.25rem * 3);
  box-shadow: 0 8px 24px oklch(0% 0 0 / 0.14);
}

.chelekom-color-input__panel[data-closed] {
  display: none;
}

.chelekom-color-input__area {
  position: relative;
  height: 9rem;
  border-radius: var(--radius-field);
  /* Saturation across, brightness down, over the chosen hue — the two gradients *are* the picker. */
  background-image:
    linear-gradient(to top, #000, #0000),
    linear-gradient(to right, #fff, #0000);
  background-color: var(--chelekom-picker-hue, #f00);
  cursor: crosshair;
}

.chelekom-color-input__thumb {
  position: absolute;
  width: calc(0.25rem * 3.5);
  height: calc(0.25rem * 3.5);
  translate: -50% -50%;
  border-radius: calc(infinity * 1px);
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px oklch(0% 0 0 / 0.35);
}

.chelekom-color-input__controls {
  display: flex;
  align-items: center;
  gap: calc(0.25rem * 2);
}

.chelekom-color-input__preview {
  width: calc(0.25rem * 8);
  height: calc(0.25rem * 8);
  flex-shrink: 0;
  border-radius: var(--radius-field);
  box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.chelekom-color-input__hue {
  @apply <%= @d %>range <%= @d %>range-xs;

  /* Left bare this was a raw browser range control sitting inside a themed panel. The track keeps
   * the hue wheel, because that gradient is the data — the rest is daisyUI's. */
  flex: 1;
  background: linear-gradient(
    to right,
    #f00 0%,
    #ff0 17%,
    #0f0 33%,
    #0ff 50%,
    #00f 67%,
    #f0f 83%,
    #f00 100%
  );
}
