/* progress — daisyUI skin.
 *
 * daisyUI's `progress` styles a native `<progress>`, painting the bar with `::-webkit-progress-value`
 * and an animated `background-image` for the indeterminate case. Ours is a div track with a real
 * indicator element, so those are daisyUI's values written against our parts. The colour modifiers
 * need nothing special: `progress-primary` only sets `color`, and the bar is `currentColor`.
 */

.chelekom-progress {
  display: block;
  width: 100%;
}

.chelekom-progress__label {
  display: block;
  margin-bottom: calc(0.25rem * 1);
  font-size: 0.875rem;
  color: var(--color-base-content);
}

.chelekom-progress__track {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 0.5rem;
  border-radius: var(--radius-box);
  background-color: color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.chelekom-progress__indicator {
  height: 100%;
  border-radius: inherit;
  background-color: currentColor;
  transition: width 0.2s ease-out;
}

/* Indeterminate: daisyUI slides a 5%-wide bar across the track on a 5s loop. */
.chelekom-progress[data-indeterminate] .chelekom-progress__indicator,
.chelekom-progress__track[data-indeterminate] .chelekom-progress__indicator {
  width: 100%;
  background-color: transparent;
  background-image: repeating-linear-gradient(
    90deg,
    currentColor -1%,
    currentColor 10%,
    #0000 10%,
    #0000 90%
  );
  background-size: 200%;
  background-position-x: 15%;
}

@media (prefers-reduced-motion: no-preference) {
  .chelekom-progress[data-indeterminate] .chelekom-progress__indicator,
  .chelekom-progress__track[data-indeterminate] .chelekom-progress__indicator {
    animation: chelekom-progress-loading 5s ease-in-out infinite;
  }
}

@keyframes chelekom-progress-loading {
  50% {
    background-position-x: -115%;
  }
}

.chelekom-progress__value {
  font-size: 0.875rem;
  color: color-mix(in oklab, var(--color-base-content) 70%, transparent);
}
