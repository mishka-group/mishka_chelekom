/* editor — daisyUI skin.
 *
 * daisyUI has no editor. The frame is a `textarea`'s box so the control matches the other fields
 * on a form, and the toolbar is a strip of `btn btn-sm btn-ghost` — daisyUI's own treatment for a
 * row of small actions.
 */

.chelekom-editor {
  border-radius: var(--radius-field);
  border: var(--border) solid color-mix(in oklab, var(--color-base-content) 20%, #0000);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
  overflow: hidden;
}

.chelekom-editor:focus-within {
  outline: 2px solid var(--color-base-content);
  outline-offset: 2px;
}

.chelekom-editor__toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: calc(0.25rem * 1);
  border-bottom: var(--border) solid color-mix(in oklab, var(--color-base-content) 12%, #0000);
  padding: calc(0.25rem * 1);
}

.chelekom-editor__toolbar button {
  @apply <%= @d %>btn <%= @d %>btn-sm <%= @d %>btn-ghost;
}

/* The pressed state of a formatting button is `aria-pressed`, not a class the caller toggles. */
.chelekom-editor__toolbar button[aria-pressed="true"] {
  @apply <%= @d %>btn-active;
}

.chelekom-editor__surface {
  min-height: 8rem;
  padding: calc(0.25rem * 3);
  outline: none;
}

.chelekom-editor__surface:empty::before {
  content: attr(data-placeholder);
  opacity: 45%;
}
