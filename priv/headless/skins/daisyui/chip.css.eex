/* chip — daisyUI skin.
 *
 * A chip is a badge you can pick, so it paints daisyUI's `badge` and takes every `badge-*`
 * modifier. The part daisyUI has no equivalent for is the *selected* state — its badges are
 * decoration, not controls — so the checked treatment is ours: the outline fills in, which is the
 * same visual language its `btn-active` uses.
 *
 * The input is visually hidden rather than `display: none`, because a hidden input cannot be
 * focused and the chip has to be reachable by keyboard.
 */

.chelekom-chip {
  @apply <%= @d %>badge <%= @d %>badge-outline;

  position: relative;
  cursor: pointer;
  user-select: none;
}

.chelekom-chip__input {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border-width: 0;
}

.chelekom-chip:has(.chelekom-chip__input:checked) {
  background-color: currentcolor;
  color: var(--color-base-100);
}

.chelekom-chip:has(.chelekom-chip__input:focus-visible) {
  outline: 2px solid currentcolor;
  outline-offset: 2px;
}

.chelekom-chip[data-disabled] {
  cursor: not-allowed;
  opacity: 50%;
}
