/* accordion — daisyUI skin (paints `collapse`; behavior stays in the headless component). */

.chelekom-accordion {
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  border: var(--border) solid var(--color-base-300);
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
}

.chelekom-accordion__item {
  @apply <%= @d %>collapse;
  display: block;
  border-radius: 0;
}

.chelekom-accordion__item + .chelekom-accordion__item {
  border-top: var(--border) solid var(--color-base-300);
}

.chelekom-accordion__heading {
  margin: 0;
}

.chelekom-accordion__trigger {
  @apply <%= @d %>collapse-title;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(0.25rem * 4);
  font-size: 0.875rem;
  font-weight: 500;
  text-align: start;
  cursor: pointer;
  user-select: none;
}

/* The arrow is ours only when the trigger has no icon of its own. */
.chelekom-accordion__trigger:not(:has(> *)):after {
  content: "";
  position: absolute;
  display: block;
  top: 50%;
  inset-inline-end: 1.4rem;
  height: 0.5rem;
  width: 0.5rem;
  transform: translateY(-100%) rotate(45deg);
  transform-origin: 75% 75%;
  box-shadow: 2px 2px;
  pointer-events: none;
}

@media (prefers-reduced-motion: no-preference) {
  .chelekom-accordion__trigger:not(:has(> *)):after {
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chelekom-accordion__trigger[data-panel-open]:not(:has(> *)):after {
    transform: translateY(-50%) rotate(225deg);
  }
}

.chelekom-accordion__trigger:hover:not([data-disabled]) {
  background-color: color-mix(in oklab, var(--color-base-content) 6%, transparent);
}

.chelekom-accordion__trigger:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: -2px;
}

.chelekom-accordion__trigger[data-disabled] {
  cursor: not-allowed;
  color: color-mix(in oklab, var(--color-base-content) 30%, transparent);
}

.chelekom-accordion__panel {
  height: var(--accordion-panel-height);
  overflow: hidden;
  padding-inline: 1rem;
  padding-bottom: 1rem;
  font-size: 0.875rem;
  color: color-mix(in oklab, var(--color-base-content) 70%, transparent);
}

@media (prefers-reduced-motion: no-preference) {
  .chelekom-accordion__panel {
    transition: height 0.2s ease-out;
  }
}

.chelekom-accordion__panel[data-starting-style],
.chelekom-accordion__panel[data-ending-style] {
  height: 0;
}
