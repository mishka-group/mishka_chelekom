/* dialog — daisyUI skin (popup paints `modal-box`; the overlay layout stays in the base CSS). */

.chelekom-dialog__trigger {
  @apply <%= @d %>btn;
}

.chelekom-dialog__backdrop {
  background-color: oklch(0% 0 0 / 0.4);
  transition: opacity 0.3s ease-out;
}

.chelekom-dialog__backdrop[data-starting-style],
.chelekom-dialog__backdrop[data-ending-style] {
  opacity: 0;
}

.chelekom-dialog__viewport {
  padding: 1rem;
}

.chelekom-dialog__popup {
  @apply <%= @d %>modal-box;
  scale: 100%;
  opacity: 1;
}

.chelekom-dialog__popup[data-starting-style],
.chelekom-dialog__popup[data-ending-style] {
  scale: 95%;
  opacity: 0;
}

.chelekom-dialog__title {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-base-content);
}

.chelekom-dialog__description {
  padding-top: calc(0.25rem * 2);
  font-size: 0.875rem;
  color: color-mix(in oklab, var(--color-base-content) 70%, transparent);
}

.chelekom-dialog__content {
  padding-top: calc(0.25rem * 2);
  font-size: 0.875rem;
  color: var(--color-base-content);
}

.chelekom-dialog__footer {
  @apply <%= @d %>modal-action;
}
