/* slider — daisyUI skin (the `range` look).
 *
 * daisyUI's `range` styles a native `<input type=range>` through `::-webkit-slider-thumb` and a
 * `--range-fill` gradient on the track. Ours is a track/indicator/thumb trio the Slider engine
 * drives, so these are daisyUI's values written against our parts — which also means `range-vertical`
 * is unnecessary: `orientation="vertical"` already turns the control on its side.
 *
 * `--<%= @d %>range-bg`, `--<%= @d %>range-thumb` and `--<%= @d %>range-fill` are daisyUI's own variables, so its
 * custom-colour recipe works here unchanged.
 */

.chelekom-slider {
  --<%= @d %>range-thumb: var(--color-base-100);
  --<%= @d %>range-bg: currentColor;
  --<%= @d %>range-fill: 1;
  --<%= @d %>range-thumb-size: calc(var(--size-selector, 0.25rem) * 6);
  display: flex;
  flex-direction: column;
  gap: calc(0.25rem * 1);
  width: 100%;
  color: var(--color-base-content);
}

.chelekom-slider__label,
.chelekom-slider__value {
  font-size: 0.875rem;
}

.chelekom-slider__control {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: calc(var(--size-field, 0.25rem) * 6);
  cursor: pointer;
  touch-action: none;
}

.chelekom-slider__track {
  position: relative;
  width: 100%;
  height: 0.5rem;
  border-radius: calc(infinity * 1px);
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-slider__indicator {
  height: 100%;
  border-radius: inherit;
  background-color: var(--<%= @d %>range-bg);
  opacity: var(--<%= @d %>range-fill);
}

.chelekom-slider__thumb {
  width: var(--<%= @d %>range-thumb-size);
  height: var(--<%= @d %>range-thumb-size);
  border-radius: calc(infinity * 1px);
  background-color: var(--<%= @d %>range-thumb);
  color: var(--<%= @d %>range-bg);
  box-shadow:
    0 0 0 3px var(--<%= @d %>range-bg) inset,
    0 0 0 var(--border) var(--<%= @d %>range-bg),
    0 1px 3px -1px oklch(0% 0 0 / calc(var(--depth) * 0.3));
  cursor: grab;
}

.chelekom-slider__thumb[data-dragging] {
  cursor: grabbing;
}

.chelekom-slider__thumb:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.chelekom-slider[data-disabled] {
  cursor: not-allowed;
  opacity: 30%;
}

/* The size modifiers are gated on `input[type=range]`, which our control is not — so honour
 * daisyUI's own thumb scale here, on the root. */
.chelekom-slider.<%= @d %>range-xs {
  --<%= @d %>range-thumb-size: calc(var(--size-selector, 0.25rem) * 4);
}

.chelekom-slider.<%= @d %>range-sm {
  --<%= @d %>range-thumb-size: calc(var(--size-selector, 0.25rem) * 5);
}

.chelekom-slider.<%= @d %>range-md {
  --<%= @d %>range-thumb-size: calc(var(--size-selector, 0.25rem) * 6);
}

.chelekom-slider.<%= @d %>range-lg {
  --<%= @d %>range-thumb-size: calc(var(--size-selector, 0.25rem) * 7);
}

.chelekom-slider.<%= @d %>range-xl {
  --<%= @d %>range-thumb-size: calc(var(--size-selector, 0.25rem) * 8);
}

/* Vertical: the same parts, stood up. */
.chelekom-slider[data-orientation="vertical"] .chelekom-slider__control {
  width: auto;
  height: 12rem;
}

.chelekom-slider[data-orientation="vertical"] .chelekom-slider__track {
  width: 0.5rem;
  height: 100%;
}

.chelekom-slider[data-orientation="vertical"] .chelekom-slider__indicator {
  width: 100%;
}
