/* nav_link — daisyUI skin (a menu row, the shape a nav link takes in daisyUI's `menu`). */

.chelekom-nav-link__control {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(auto, max-content) auto max-content;
  align-items: center;
  gap: calc(0.25rem * 2);
  padding-inline: calc(0.25rem * 3);
  padding-block: calc(0.25rem * 1.5);
  border-radius: var(--radius-field);
  font-size: 0.875rem;
  text-align: start;
  cursor: pointer;
  user-select: none;
  transition-property: color, background-color, box-shadow;
  transition-duration: 0.2s;
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
}

.chelekom-nav-link__control:hover:not([data-disabled]) {
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-nav-link__control[data-active],
.chelekom-nav-link__control[aria-current] {
  background-color: var(--color-neutral);
  color: var(--color-neutral-content);
}

.chelekom-nav-link__control[data-disabled] {
  pointer-events: none;
  color: color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.chelekom-nav-link__children {
  margin-inline-start: calc(0.25rem * 4);
  padding-inline-start: calc(0.25rem * 2);
  border-inline-start: var(--border) solid
    color-mix(in oklab, var(--color-base-content) 10%, transparent);
}
