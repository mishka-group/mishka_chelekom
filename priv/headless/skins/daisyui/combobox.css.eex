/* combobox — daisyUI skin.
 *
 * Same surfaces as the autocomplete — `input` for the control, `dropdown-content menu` for the
 * list — with two additions daisyUI has nothing for: the chips a multi-select shows inside the
 * control, and the "create this one" row at the bottom of the list.
 *
 * The control is drawn rather than given `input`, because it has to grow to fit the chips and
 * `input` is a fixed-height row.
 */

.chelekom-combobox__control {
  border-radius: var(--radius-field);
  border: var(--border) solid color-mix(in oklab, var(--color-base-content) 20%, #0000);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: calc(0.25rem * 1.5);
  padding: calc(0.25rem * 1.5);
  min-height: calc(var(--size-field, 0.25rem) * 10);
}

.chelekom-combobox__control:focus-within {
  outline: 2px solid var(--color-base-content);
  outline-offset: 2px;
}

.chelekom-combobox__input {
  flex: 1;
  min-width: 6rem;
  border: none;
  background: transparent;
  outline: none;
  font-size: 0.875rem;
}

.chelekom-combobox__chip {
  @apply <%= @d %>badge <%= @d %>badge-neutral <%= @d %>badge-sm;

  gap: calc(0.25rem * 1);
}

.chelekom-combobox__chip-remove {
  cursor: pointer;
  opacity: 70%;
}

.chelekom-combobox__popup {
  @apply <%= @d %>menu <%= @d %>dropdown-content;

  position: absolute;
  z-index: 50;
  max-height: 16rem;
  overflow-y: auto;
  width: 100%;
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  box-shadow: 0 4px 12px oklch(0% 0 0 / 0.12);
}

.chelekom-combobox__popup[data-closed] {
  display: none;
}

.chelekom-combobox__item {
  border-radius: var(--radius-field);
  padding-inline: calc(0.25rem * 3);
  padding-block: calc(0.25rem * 1.5);
  cursor: pointer;
}

.chelekom-combobox__item[data-highlighted] {
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-combobox__item[aria-selected="true"] {
  @apply <%= @d %>menu-active;
}

.chelekom-combobox__group-label {
  padding-inline: calc(0.25rem * 3);
  font-size: 0.75rem;
  opacity: 60%;
}

.chelekom-combobox__empty {
  padding: calc(0.25rem * 3);
  font-size: 0.875rem;
  opacity: 65%;
}

.chelekom-combobox__create {
  border-top: var(--border) solid color-mix(in oklab, var(--color-base-content) 12%, #0000);
  padding: calc(0.25rem * 2) calc(0.25rem * 3);
  cursor: pointer;
  font-size: 0.875rem;
}

.chelekom-combobox__trigger,
.chelekom-combobox__clear {
  @apply <%= @d %>btn <%= @d %>btn-xs <%= @d %>btn-circle <%= @d %>btn-ghost;
}
