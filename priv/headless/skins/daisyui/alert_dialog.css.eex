/* alert_dialog — daisyUI skin.
 *
 * daisyUI's `modal` is a `<dialog>` with `modal-box` inside and `modal-backdrop` behind. Ours is
 * not a `<dialog>` — an alert dialog must never be dismissed by Escape or by clicking away, and
 * `<dialog>` gives both away for free — so `modal-box` is borrowed for the panel and the backdrop
 * is drawn here rather than taken from a class that expects the native element.
 */

/* The trigger is a real button, so it takes daisyUI's button — same as the plain dialog's. */
.chelekom-alert-dialog__trigger {
  @apply <%= @d %>btn;
}

.chelekom-alert-dialog__popup {
  @apply <%= @d %>modal-box;

  /* The base stylesheet already pins and centres this panel, with `transform`. Repeating that here
   * as `translate` does not override it — the two compose, and the dialog lands a full width and
   * height off-centre. All this layer owes is the depth. */
  z-index: 60;

  /* `modal-box` is drawn closed — scaled down and transparent — because inside a `modal` it is the
   * `modal-open` state that reveals it. This panel has no `modal` around it, so it has to undo
   * that or it opens invisible. */
  scale: 100%;
  opacity: 1;
}

.chelekom-alert-dialog__popup[data-closed] {
  display: none;
}

.chelekom-alert-dialog__backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  background-color: oklch(0% 0 0 / 0.4);
}

.chelekom-alert-dialog__backdrop[data-closed] {
  display: none;
}

.chelekom-alert-dialog__title {
  font-size: 1.125rem;
  font-weight: 700;
}

.chelekom-alert-dialog__description {
  padding-top: calc(0.25rem * 2);
  opacity: 75%;
}

.chelekom-alert-dialog__actions {
  @apply <%= @d %>modal-action;
}

/* `modal-action` lays the row out but leaves the buttons to the caller, and there are no classes
 * here to leave them to. The last one is the action the dialog is asking about — the one the copy
 * names — so it carries the weight and the rest step back. */
.chelekom-alert-dialog__actions button,
.chelekom-alert-dialog__actions a {
  @apply <%= @d %>btn <%= @d %>btn-sm;
}

/* Ghost only on the ones stepping back: `btn-ghost` forces a transparent background, and on the
 * confirming button it would beat `btn-primary` to it — leaving coloured text on nothing. */
.chelekom-alert-dialog__actions > :not(:last-child) {
  @apply <%= @d %>btn-ghost;
}

.chelekom-alert-dialog__actions > :last-child {
  @apply <%= @d %>btn-primary;
}
