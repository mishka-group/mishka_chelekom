/* popover — daisyUI skin.
 *
 * daisyUI's popover is `dropdown-content` in a `card`-ish box, so that is what the panel borrows.
 * The arrow is ours — daisyUI draws none — and it is a rotated square positioned from the side the
 * engine resolved, which is why it keys off `data-side` rather than a class.
 */

/* The trigger is a real button, so it takes daisyUI's button — same as the dialog's. */
.chelekom-popover__trigger {
  @apply <%= @d %>btn;
}

.chelekom-popover__popup {
  @apply <%= @d %>dropdown-content;

  position: absolute;
  z-index: 50;
  min-width: 16rem;
  border-radius: var(--radius-box);
  border: var(--border) solid color-mix(in oklab, var(--color-base-content) 10%, #0000);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
  padding: calc(0.25rem * 4);
  box-shadow: 0 8px 24px oklch(0% 0 0 / 0.14);
}

.chelekom-popover__popup[data-closed] {
  display: none;
}

.chelekom-popover__title {
  font-weight: 600;
}

.chelekom-popover__description {
  font-size: 0.875rem;
  opacity: 70%;
}

.chelekom-popover__footer {
  display: flex;
  justify-content: flex-end;
  gap: calc(0.25rem * 2);
  padding-top: calc(0.25rem * 3);
}

.chelekom-popover__backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background-color: oklch(0% 0 0 / 0.2);
}

.chelekom-popover__arrow {
  position: absolute;
  width: calc(0.25rem * 2);
  height: calc(0.25rem * 2);
  rotate: 45deg;
  border: var(--border) solid color-mix(in oklab, var(--color-base-content) 10%, #0000);
  background-color: var(--color-base-100);
}

/* Only the two edges facing the trigger keep their border, so the arrow reads as part of the box
 * rather than as a diamond stuck to it. */
.chelekom-popover__popup[data-side="bottom"] .chelekom-popover__arrow {
  top: calc(0.25rem * -1);
  border-inline-end: none;
  border-block-end: none;
}

.chelekom-popover__popup[data-side="top"] .chelekom-popover__arrow {
  bottom: calc(0.25rem * -1);
  border-inline-start: none;
  border-block-start: none;
}

.chelekom-popover__popup[data-side="right"] .chelekom-popover__arrow {
  inset-inline-start: calc(0.25rem * -1);
  border-inline-end: none;
  border-block-start: none;
}

.chelekom-popover__popup[data-side="left"] .chelekom-popover__arrow {
  inset-inline-end: calc(0.25rem * -1);
  border-inline-start: none;
  border-block-end: none;
}
