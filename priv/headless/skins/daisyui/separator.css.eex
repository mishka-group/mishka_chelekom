/* separator — daisyUI skin (paints `divider`, including the label-in-the-middle layout). */

.chelekom-separator {
  @apply <%= @d %>divider;
}

.chelekom-separator[data-orientation="vertical"] {
  @apply <%= @d %>divider-horizontal;
}

.chelekom-separator__label {
  padding-inline: calc(0.25rem * 2);
  font-size: 0.875rem;
  color: var(--color-base-content);
}
