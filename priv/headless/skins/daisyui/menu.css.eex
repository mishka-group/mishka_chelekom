/* menu — daisyUI skin (trigger paints `btn`, popups paint `menu`).
 *
 * daisyUI's row styling is scoped to `li > *`, which our button/anchor rows are not, so the item
 * declarations are daisyUI's values written against our parts.
 */

.chelekom-menu__trigger {
  @apply <%= @d %>btn;
}

.chelekom-menu__popup,
.chelekom-menu__submenu-popup {
  @apply <%= @d %>menu;
  flex-wrap: nowrap;
  min-width: 12rem;
  border: var(--border) solid var(--color-base-300);
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
  box-shadow:
    0 4px 6px -1px oklch(0% 0 0 / 0.1),
    0 2px 4px -2px oklch(0% 0 0 / 0.1);
}

.chelekom-menu__item,
.chelekom-menu__link-item,
.chelekom-menu__checkbox-item,
.chelekom-menu__radio-item,
.chelekom-menu__submenu-trigger {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(auto, max-content) auto max-content;
  align-items: center;
  gap: calc(0.25rem * 2);
  width: 100%;
  padding-inline: calc(0.25rem * 3);
  padding-block: calc(0.25rem * 1.5);
  border-radius: var(--radius-field);
  font-size: 0.875rem;
  text-align: start;
  cursor: pointer;
  user-select: none;
  transition-property: color, background-color, box-shadow;
  transition-duration: 0.2s;
  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);
}

.chelekom-menu__item[data-highlighted],
.chelekom-menu__link-item[data-highlighted],
.chelekom-menu__checkbox-item[data-highlighted],
.chelekom-menu__radio-item[data-highlighted],
.chelekom-menu__submenu-trigger[data-highlighted] {
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-menu__item[data-disabled],
.chelekom-menu__link-item[data-disabled],
.chelekom-menu__checkbox-item[data-disabled],
.chelekom-menu__radio-item[data-disabled],
.chelekom-menu__submenu-trigger[data-disabled] {
  pointer-events: none;
  color: color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.chelekom-menu__group-label {
  @apply <%= @d %>menu-title;
  display: block;
}

.chelekom-menu__separator {
  height: 1px;
  margin: 0.5rem 0.25rem;
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-menu__chevron {
  justify-self: flex-end;
  color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
}

.chelekom-menu__indicator {
  display: inline-flex;
  width: 1rem;
  justify-content: center;
  font-size: 0.75rem;
  line-height: 1;
}
