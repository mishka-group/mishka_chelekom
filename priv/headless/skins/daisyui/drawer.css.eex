/* drawer — daisyUI skin.
 *
 * daisyUI's `drawer` is a CSS-only sidebar: a hidden checkbox, a `drawer-side` that slides via
 * `translate`, and a label acting as the overlay. Ours is a real popup the Drawer engine positions
 * and swipes, so this is daisyUI's `drawer-side` / `drawer-overlay` look written against our parts,
 * keyed off the `data-side` and `data-open` the engine already sets.
 */

.chelekom-drawer__trigger {
  @apply <%= @d %>btn;
}

.chelekom-drawer__backdrop {
  background-color: oklch(0% 0 0 / 0.4);
  transition: opacity 0.3s ease-out;
}

.chelekom-drawer__backdrop[data-starting-style],
.chelekom-drawer__backdrop[data-ending-style] {
  opacity: 0;
}

.chelekom-drawer__popup {
  display: flex;
  flex-direction: column;
  gap: calc(0.25rem * 3);
  min-width: 18rem;
  max-width: min(24rem, 90vw);
  padding: calc(0.25rem * 6);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
  box-shadow: oklch(0% 0 0 / 0.25) 0 25px 50px -12px;
}

.chelekom-drawer__popup[data-side="bottom"],
.chelekom-drawer__popup[data-side="top"] {
  max-width: none;
  width: 100%;
  max-height: 90vh;
}

.chelekom-drawer__popup[data-side="bottom"] {
  border-start-start-radius: var(--radius-box);
  border-start-end-radius: var(--radius-box);
}

.chelekom-drawer__popup[data-side="top"] {
  border-end-start-radius: var(--radius-box);
  border-end-end-radius: var(--radius-box);
}

.chelekom-drawer__handle {
  align-self: center;
  width: calc(0.25rem * 10);
  height: calc(0.25rem * 1);
  border-radius: calc(infinity * 1px);
  background-color: color-mix(in oklab, var(--color-base-content) 20%, transparent);
}

.chelekom-drawer__title {
  font-size: 1.125rem;
  font-weight: 700;
}

.chelekom-drawer__description {
  font-size: 0.875rem;
  color: color-mix(in oklab, var(--color-base-content) 70%, transparent);
}

.chelekom-drawer__content {
  flex: 1 1 auto;
  overflow-y: auto;
  font-size: 0.875rem;
}

.chelekom-drawer__footer {
  @apply <%= @d %>modal-action;
}
