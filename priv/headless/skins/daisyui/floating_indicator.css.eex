/* floating_indicator — daisyUI skin.
 *
 * The pill that slides behind whichever item is active. daisyUI has no equivalent — its own tabs
 * move a border, not a box — so this is drawn from tokens. The transition is on `transform` and
 * `width` because the engine writes those, and honouring reduced motion means jumping instead of
 * sliding rather than not moving at all.
 */

/* The strip itself. Without this the targets are bare buttons and collapse into one run-on word;
 * the shape borrowed here is daisyUI's `tabs-boxed`, which is what a sliding indicator sits in. */
.chelekom-floating-indicator {
  position: relative;
  display: inline-flex;
  align-items: stretch;
  gap: calc(0.25rem * 0.5);
  border-radius: var(--radius-field);
  background-color: var(--color-base-200);
  padding: calc(0.25rem * 0.5);
}

.chelekom-floating-indicator__indicator {
  position: absolute;
  z-index: 0;
  border-radius: var(--radius-field);
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
  transition:
    transform 0.2s ease-out,
    width 0.2s ease-out,
    height 0.2s ease-out;
}

@media (prefers-reduced-motion: reduce) {
  .chelekom-floating-indicator__indicator {
    transition: none;
  }
}

/* Ghost, not plain `btn`: the indicator behind it is what marks the active one, so a filled or
 * bordered button would draw a second box around the same choice. */
.chelekom-floating-indicator__target {
  @apply <%= @d %>btn <%= @d %>btn-sm <%= @d %>btn-ghost;

  position: relative;
  z-index: 1;
  border: none;
}
