/* calendar — daisyUI skin.
 *
 * There is nothing to borrow here: daisyUI ships no calendar, only styling for Cally, React Day
 * Picker and Vanilla Calendar Pro, each keyed to that library's own markup and shadow parts. So
 * this fragment is written from daisyUI's *tokens* rather than mirrored from its rules — the same
 * radii, sizes and colours the rest of the skin uses, so the calendar belongs to the theme even
 * though no daisyUI component corresponds to it.
 */

.chelekom-calendar {
  display: inline-flex;
  flex-direction: column;
  gap: calc(0.25rem * 2);
  padding: calc(0.25rem * 3);
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  color: var(--color-base-content);
}

.chelekom-calendar__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(0.25rem * 2);
}

.chelekom-calendar__control {
  @apply <%= @d %>btn <%= @d %>btn-ghost <%= @d %>btn-sm <%= @d %>btn-circle;
}

.chelekom-calendar__heading {
  font-weight: 600;
}

.chelekom-calendar__grid {
  border-collapse: collapse;
}

.chelekom-calendar__weekday {
  padding: calc(0.25rem * 1);
  font-size: 0.75rem;
  font-weight: 500;
  opacity: 60%;
}

.chelekom-calendar__cell {
  padding: 1px;
}

.chelekom-calendar__day {
  display: grid;
  place-items: center;
  width: calc(0.25rem * 9);
  height: calc(0.25rem * 9);
  border-radius: var(--radius-field);
  font-size: 0.875rem;
  cursor: pointer;
  transition: background-color 0.15s ease-out;
}

.chelekom-calendar__day:hover {
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-calendar__day:focus-visible {
  outline: 2px solid var(--color-base-content);
  outline-offset: 2px;
}

/* A day from the neighbouring month is context, not a target — visible but plainly secondary. */
.chelekom-calendar__day[data-outside] {
  opacity: 35%;
}

.chelekom-calendar__day[aria-current="date"] {
  box-shadow: inset 0 0 0 1px var(--color-primary);
  font-weight: 600;
}

.chelekom-calendar__day[data-selected] {
  background-color: var(--color-primary);
  color: var(--color-primary-content);
}

.chelekom-calendar__day[data-selected]:hover {
  background-color: var(--color-primary);
}

/* The middle of a range is tinted rather than filled, so the two ends stay legible as the ends. */
.chelekom-calendar__day[data-in-range] {
  background-color: color-mix(in oklab, var(--color-primary) 18%, transparent);
  border-radius: 0;
}

.chelekom-calendar__day[data-range-start] {
  border-start-end-radius: 0;
  border-end-end-radius: 0;
}

.chelekom-calendar__day[data-range-end] {
  border-start-start-radius: 0;
  border-end-start-radius: 0;
}

.chelekom-calendar__day[aria-disabled="true"] {
  cursor: not-allowed;
  opacity: 30%;
}

.chelekom-calendar__day[aria-disabled="true"]:hover {
  background-color: transparent;
}
