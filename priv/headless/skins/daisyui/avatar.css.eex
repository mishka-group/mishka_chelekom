/* avatar — daisyUI skin (root paints `avatar`; the loading state stays the component's). */

.chelekom-avatar {
  @apply <%= @d %>avatar;
  display: inline-flex;
  width: calc(var(--size-field, 0.25rem) * 12);
}

.chelekom-avatar__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: inherit;
}

/* daisyUI's placeholder centres initials on a neutral chip; ours is the fallback part, revealed
 * by the Avatar hook via `data-status`, so the same look keys off that instead of `:empty`. */
.chelekom-avatar__fallback {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  border-radius: inherit;
  background-color: var(--color-neutral);
  color: var(--color-neutral-content);
  font-size: 0.875rem;
  user-select: none;
}
