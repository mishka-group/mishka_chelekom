/* spoiler — daisyUI skin.
 *
 * daisyUI's nearest thing is `collapse`, but a collapse hides its content behind a title bar. A
 * spoiler shows the beginning and clips the rest, so the box itself is drawn here and only the
 * toggle borrows daisyUI — `btn btn-sm btn-ghost`, the same treatment its own inline actions get.
 *
 * The fade over the clipped edge is the part that makes it read as "there is more": without it a
 * hard cut looks like the text simply ended.
 */

.chelekom-spoiler {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: calc(0.25rem * 2);
  color: var(--color-base-content);
}

.chelekom-spoiler__content {
  position: relative;
  overflow: hidden;
  /* Collapsed by default, so the clamp is right before any JS runs; the root gains
   * `data-expanded` when the control is used. */
  max-height: 6rem;
  transition: max-height 0.2s ease-out;
}

.chelekom-spoiler[data-expanded] .chelekom-spoiler__content {
  max-height: 60rem;
}

.chelekom-spoiler__content::after {
  content: "";
  position: absolute;
  inset-inline: 0;
  bottom: 0;
  height: 2.5rem;
  background: linear-gradient(to bottom, #0000, var(--color-base-100));
  pointer-events: none;
}

/* Both labels are always in the DOM; exactly one of them is shown. */
.chelekom-spoiler[data-expanded] .chelekom-spoiler__content::after {
  display: none;
}

.chelekom-spoiler [data-part="hide-label"],
.chelekom-spoiler[data-expanded] [data-part="show-label"] {
  display: none;
}

.chelekom-spoiler[data-expanded] [data-part="hide-label"] {
  display: inline;
}

.chelekom-spoiler__control {
  @apply <%= @d %>btn <%= @d %>btn-sm <%= @d %>btn-ghost;
}
