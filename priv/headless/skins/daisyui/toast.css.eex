/* toast — daisyUI skin (viewport paints `toast`, each toast paints `alert`).
 *
 * daisyUI's `toast` is the fixed corner stack and `alert` is the card inside it — exactly our
 * viewport/toast split, so both `@apply` cleanly. Placement (`toast-top`, `toast-center`, …) is a
 * class on the viewport, which the component already lets a caller set.
 */

.chelekom-toast__viewport {
  @apply <%= @d %>toast;
}

.chelekom-toast__toast {
  @apply <%= @d %>alert;
  width: max-content;
  max-width: min(24rem, calc(100vw - 2rem));
}

@media (prefers-reduced-motion: no-preference) {
  .chelekom-toast__toast {
    transition: opacity 0.2s ease-out, translate 0.2s ease-out;
  }
}

.chelekom-toast__toast[data-starting-style],
.chelekom-toast__toast[data-ending-style] {
  opacity: 0;
  translate: 0 0.5rem;
}

.chelekom-toast__content {
  display: flex;
  flex-direction: column;
  gap: calc(0.25rem * 1);
  text-align: start;
}

.chelekom-toast__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-inline-start: auto;
  border-radius: var(--radius-selector);
  cursor: pointer;
  opacity: 60%;
  transition: opacity 0.2s ease-out;
}

.chelekom-toast__close:hover {
  opacity: 100%;
}

.chelekom-toast__close:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 1px;
}

.chelekom-toast__trigger {
  @apply <%= @d %>btn;
}
