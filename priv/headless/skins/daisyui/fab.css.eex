/* fab — daisyUI skin.
 *
 * daisyUI drives the whole component from `:focus-within` on `.fab > [tabindex]:first-child`, and
 * positions the actions with `.fab > *`. Our markup is a real `<button>` and a `role="menu"`
 * popup, so none of those selectors match — the layout is mirrored here and keyed off `data-open`,
 * which the shared Popup engine already sets. That is what buys Escape, outside-click and
 * `aria-expanded`, none of which a `:focus-within` dial has.
 */

.chelekom-fab {
  pointer-events: none;
  position: fixed;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  gap: calc(0.25rem * 2);
  font-size: var(--text-sm);
  white-space: nowrap;
  user-select: none;
}

.chelekom-fab[data-contained] {
  position: absolute;
}

.chelekom-fab[data-placement="bottom-end"] {
  inset-inline-end: calc(0.25rem * 4);
  bottom: calc(0.25rem * 4);
}

.chelekom-fab[data-placement="bottom-start"] {
  inset-inline-start: calc(0.25rem * 4);
  bottom: calc(0.25rem * 4);
  align-items: flex-start;
}

.chelekom-fab[data-placement="top-end"] {
  inset-inline-end: calc(0.25rem * 4);
  top: calc(0.25rem * 4);
}

.chelekom-fab[data-placement="top-start"] {
  inset-inline-start: calc(0.25rem * 4);
  top: calc(0.25rem * 4);
  align-items: flex-start;
}

.chelekom-fab > * {
  pointer-events: auto;
}

.chelekom-fab__trigger {
  @apply <%= @d %>btn <%= @d %>btn-circle <%= @d %>btn-lg;

  display: grid;
  place-items: center;
  transition:
    rotate 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* One glyph at a time: the closed one until the dial opens, the close one after. */
.chelekom-fab__icon[data-state="open"] {
  display: none;
}

.chelekom-fab:has([data-part="popup"][data-open]) .chelekom-fab__icon[data-state="closed"] {
  display: none;
}

.chelekom-fab:has([data-part="popup"][data-open]) .chelekom-fab__icon[data-state="open"] {
  display: block;
}

.chelekom-fab:has([data-part="popup"][data-open]) .chelekom-fab__trigger {
  rotate: 45deg;
}

.chelekom-fab:has([data-part="popup"][data-open]) .chelekom-fab__trigger:has(
    .chelekom-fab__icon[data-state="open"]
  ) {
  rotate: none;
}

/* The dial itself. Closed it is not merely invisible — it is out of the layout and out of the tab
 * order, which `display: none` gives us and `opacity: 0` would not. */
.chelekom-fab__popup {
  display: flex;
  flex-direction: column-reverse;
  align-items: inherit;
  gap: calc(0.25rem * 2);
  position: relative;
}

.chelekom-fab__popup[data-closed] {
  display: none;
}

.chelekom-fab[data-direction="down"] .chelekom-fab__popup {
  flex-direction: column;
}

.chelekom-fab[data-direction="left"] .chelekom-fab__popup {
  flex-direction: row-reverse;
  align-items: center;
}

.chelekom-fab[data-direction="right"] .chelekom-fab__popup {
  flex-direction: row;
  align-items: center;
}

.chelekom-fab__action {
  @apply <%= @d %>btn <%= @d %>btn-circle;

  display: flex;
  align-items: center;
  gap: calc(0.25rem * 2);
}

/* An action with a visible label is no longer a circle. */
.chelekom-fab__action:has(.chelekom-fab__label) {
  border-radius: var(--radius-field);
  width: auto;
  padding-inline: calc(0.25rem * 4);
}

.chelekom-fab__action[data-disabled] {
  pointer-events: none;
  opacity: 50%;
}

.chelekom-fab__action[data-part="main-action"] {
  @apply <%= @d %>btn-lg;
}

/* Flower: daisyUI arranges the actions on a quarter circle instead of a column. Three positions is
 * what the shape can hold without the buttons touching. */
.chelekom-fab[data-direction="flower"] .chelekom-fab__popup {
  display: block;
  width: calc(0.25rem * 12);
  height: calc(0.25rem * 12);
}

.chelekom-fab[data-direction="flower"] .chelekom-fab__action {
  position: absolute;
  inset-inline-end: 0;
  bottom: 0;
}

.chelekom-fab[data-direction="flower"] .chelekom-fab__action[data-index="0"] {
  translate: 0 calc(0.25rem * -14);
}

.chelekom-fab[data-direction="flower"] .chelekom-fab__action[data-index="1"] {
  translate: calc(0.25rem * -10) calc(0.25rem * -10);
}

.chelekom-fab[data-direction="flower"] .chelekom-fab__action[data-index="2"] {
  translate: calc(0.25rem * -14) 0;
}
