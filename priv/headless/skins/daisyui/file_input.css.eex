/* file_input — daisyUI skin.
 *
 * The input is the root, so `file-input` and every modifier — `file-input-primary`,
 * `file-input-sm`, `file-input-ghost` — go on it directly and behave exactly as on daisyUI's page.
 *
 * `@apply` copies declarations but not the `::file-selector-button` rule, and that pseudo-element
 * is the browser's own "Choose file" button — the visible half of this control. Without the mirror
 * below the button renders unstyled next to a daisyUI border. The disabled state is keyed off
 * `data-disabled` as well as `:disabled`, so a server-disabled input dims even before the browser
 * agrees.
 */

.chelekom-file-input {
  @apply <%= @d %>file-input;
}

.chelekom-file-input::file-selector-button {
  --<%= @d %>size: calc(var(--size-field, 0.25rem) * 10);
  --<%= @d %>btn-bg: var(--<%= @d %>btn-color, var(--color-base-200));
  --<%= @d %>btn-fg: var(--color-base-content);
  --<%= @d %>btn-border: color-mix(in oklab, var(--<%= @d %>btn-bg), #000 5%);
  --<%= @d %>btn-shadow: 0 3px 2px -2px color-mix(in oklab, var(--<%= @d %>btn-bg) 30%, #0000),
    0 4px 3px -2px color-mix(in oklab, var(--<%= @d %>btn-bg) 30%, #0000);

  margin-inline-end: calc(0.25rem * 4);
  margin-inline-start: calc(var(--border) * -1);
  margin-block: calc(var(--border) * -1);
  height: calc(100% + var(--border) * 2);
  padding-inline: calc(0.25rem * 4);
  cursor: pointer;
  user-select: none;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--<%= @d %>btn-fg);
  border-width: var(--border);
  border-style: solid;
  border-color: var(--<%= @d %>btn-border);
  border-start-start-radius: calc(var(--join-ss, var(--radius-field) - var(--border)));
  border-end-start-radius: calc(var(--join-es, var(--radius-field) - var(--border)));
  background-color: var(--<%= @d %>btn-bg);
  background-size: calc(var(--noise) * 100%);
  background-image: var(--fx-noise);
  text-shadow: 0 0.5px oklch(1 0 0 / calc(var(--depth) * 0.15));
  box-shadow:
    0 0.5px 0 0.5px
      color-mix(
        in oklab,
        color-mix(in oklab, white 30%, var(--<%= @d %>btn-bg)) calc(var(--depth) * 20%),
        #0000
      )
      inset,
    var(--<%= @d %>btn-shadow);
}

.chelekom-file-input:focus {
  --<%= @d %>input-color: var(--color-base-content);
  box-shadow: 0 1px color-mix(in oklab, var(--<%= @d %>input-color) 10%, #0000);
  outline: 2px solid var(--<%= @d %>input-color);
  outline-offset: 2px;
  isolation: isolate;
}

.chelekom-file-input:disabled,
.chelekom-file-input[data-disabled] {
  cursor: not-allowed;
  border-color: var(--color-base-200);
  background-color: var(--color-base-200);
  box-shadow: none;
  color: color-mix(in oklch, var(--color-base-content) 20%, #0000);
}

.chelekom-file-input:disabled::file-selector-button,
.chelekom-file-input[data-disabled]::file-selector-button {
  --<%= @d %>btn-border: #0000;
  --<%= @d %>btn-fg: color-mix(in oklch, var(--color-base-content) 20%, #0000);

  cursor: not-allowed;
  border-color: var(--color-base-200);
  background-color: var(--color-base-200);
  background-image: none;
}

.chelekom-file-input[data-invalid] {
  --<%= @d %>input-color: var(--color-error);

  border-color: var(--<%= @d %>input-color);
}
