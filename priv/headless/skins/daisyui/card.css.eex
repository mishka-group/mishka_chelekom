/* card — daisyUI skin.
 *
 * Almost every daisyUI card rule is a *descendant* rule — `.card-xs .card-body`,
 * `.image-full > .card-body`, `.card-side :where(figure:first-child)` — so `@apply` alone paints
 * the root and leaves the body, title and figure untouched. The mirrors below keep daisyUI's own
 * modifier class as the ancestor (the caller puts `card-side`, `card-lg`, `image-full` on the root
 * exactly as on daisyUI's page) and swap only the descendant for our part.
 *
 * The corner rounding keys off `figure:first-child` / `:last-child`, which is why the component
 * renders the figure before or after the body rather than toggling a class — the selectors below
 * then work unchanged.
 */

.chelekom-card {
  @apply <%= @d %>card;
}

.chelekom-card__body {
  @apply <%= @d %>card-body;
}

.chelekom-card__title {
  @apply <%= @d %>card-title;
}

.chelekom-card__actions {
  @apply <%= @d %>card-actions;
}

.chelekom-card__figure {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.chelekom-card__figure:first-child {
  border-start-start-radius: inherit;
  border-start-end-radius: inherit;
  border-end-start-radius: unset;
  border-end-end-radius: unset;
}

.chelekom-card__figure:last-child {
  border-start-start-radius: unset;
  border-start-end-radius: unset;
  border-end-start-radius: inherit;
  border-end-end-radius: inherit;
}

/* Sizes: daisyUI drives padding and font-size through variables read by the body and the title. */
.<%= @d %>card-xs .chelekom-card__body {
  --<%= @d %>card-p: 0.5rem;
  --<%= @d %>card-fs: 0.6875rem;
}

.<%= @d %>card-xs .chelekom-card__title {
  --<%= @d %>cardtitle-fs: 0.875rem;
}

.<%= @d %>card-sm .chelekom-card__body {
  --<%= @d %>card-p: 1rem;
  --<%= @d %>card-fs: 0.75rem;
}

.<%= @d %>card-sm .chelekom-card__title {
  --<%= @d %>cardtitle-fs: 1rem;
}

.<%= @d %>card-md .chelekom-card__body {
  --<%= @d %>card-p: 1.5rem;
  --<%= @d %>card-fs: 0.875rem;
}

.<%= @d %>card-md .chelekom-card__title {
  --<%= @d %>cardtitle-fs: 1.125rem;
}

.<%= @d %>card-lg .chelekom-card__body {
  --<%= @d %>card-p: 2rem;
  --<%= @d %>card-fs: 1rem;
}

.<%= @d %>card-lg .chelekom-card__title {
  --<%= @d %>cardtitle-fs: 1.25rem;
}

.<%= @d %>card-xl .chelekom-card__body {
  --<%= @d %>card-p: 2.5rem;
  --<%= @d %>card-fs: 1.125rem;
}

.<%= @d %>card-xl .chelekom-card__title {
  --<%= @d %>cardtitle-fs: 1.375rem;
}

/* Side: the figure becomes a full-height column, so its rounding follows the left/right edge. */
.<%= @d %>card-side .chelekom-card__figure:first-child {
  border-start-start-radius: inherit;
  border-start-end-radius: unset;
  border-end-start-radius: inherit;
  border-end-end-radius: unset;
}

.<%= @d %>card-side .chelekom-card__figure:last-child {
  border-start-start-radius: unset;
  border-start-end-radius: inherit;
  border-end-start-radius: unset;
  border-end-end-radius: inherit;
}

.<%= @d %>card-side .chelekom-card__figure > * {
  width: 100%;
  height: 100%;
  max-width: unset;
  object-fit: cover;
}

/* Image-full: figure and body are stacked in one grid cell and the image is dimmed behind it. */
.<%= @d %>image-full > .chelekom-card__body {
  position: relative;
  color: var(--color-neutral-content);
}

.<%= @d %>image-full .chelekom-card__figure {
  overflow: hidden;
  border-radius: inherit;
}

/* daisyUI dims an `img`; the figure may just as well hold an svg, a picture or a video, and all of
 * them need dimming or the text on top is unreadable. */
.<%= @d %>image-full > .chelekom-card__figure :is(img, svg, picture, video) {
  height: 100%;
  object-fit: cover;
  filter: brightness(28%);
}

/* Selectable: daisyUI outlines a card that contains a checked control. Its own rule wants the input
 * as a *direct* child, which our anatomy has no room for — the body owns the content — so the
 * mirror matches a checked control anywhere inside. `aria-checked` covers a card selected by the
 * server, with no input at all. */
.chelekom-card:focus-visible,
.chelekom-card[aria-checked="true"],
.chelekom-card:has(:checked) {
  outline-color: currentcolor;
}

.chelekom-card[aria-checked="true"]:focus-visible,
.chelekom-card:has(:checked:focus-visible) {
  outline-offset: 4px;
}
