/* theme_icon — daisyUI skin.
 *
 * daisyUI's nearest equivalent is a `btn btn-square` that is not a button. Since this one is a
 * container rather than a control, it borrows the shape and none of the interaction: the base
 * surface, the field radius, and a size that matches daisyUI's own small buttons.
 */

.chelekom-theme-icon {
  display: inline-grid;
  place-items: center;
  width: calc(0.25rem * 8);
  height: calc(0.25rem * 8);
  border-radius: var(--radius-field);
  background-color: var(--color-base-200);
  color: var(--color-base-content);
}
