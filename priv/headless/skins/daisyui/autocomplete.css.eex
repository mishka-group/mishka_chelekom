/* autocomplete — daisyUI skin.
 *
 * The field is daisyUI's `input`; the list that drops out of it is `dropdown-content menu`, the
 * same surface every other menu on the page uses. The parts daisyUI has no equivalent for — the
 * empty message, the loading status, the group labels — are drawn to match it.
 */

.chelekom-autocomplete__input {
  @apply <%= @d %>input;

  width: 100%;
}

.chelekom-autocomplete__popup {
  @apply <%= @d %>menu <%= @d %>dropdown-content;

  position: absolute;
  z-index: 50;
  max-height: 16rem;
  overflow-y: auto;
  width: 100%;
  border-radius: var(--radius-box);
  background-color: var(--color-base-100);
  box-shadow: 0 4px 12px oklch(0% 0 0 / 0.12);
}

.chelekom-autocomplete__popup[data-closed] {
  display: none;
}

.chelekom-autocomplete__item {
  border-radius: var(--radius-field);
  padding-inline: calc(0.25rem * 3);
  padding-block: calc(0.25rem * 1.5);
  cursor: pointer;
}

.chelekom-autocomplete__item[data-highlighted] {
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
}

.chelekom-autocomplete__item[aria-selected="true"] {
  @apply <%= @d %>menu-active;
}

.chelekom-autocomplete__group-label {
  padding-inline: calc(0.25rem * 3);
  padding-block: calc(0.25rem * 1);
  font-size: 0.75rem;
  opacity: 60%;
}


.chelekom-autocomplete__clear {
  @apply <%= @d %>btn <%= @d %>btn-xs <%= @d %>btn-circle <%= @d %>btn-ghost;
}

.chelekom-autocomplete__empty {
  padding: calc(0.25rem * 3);
  font-size: 0.875rem;
  opacity: 65%;
}

.chelekom-autocomplete__group-list {
  display: contents;
}
