/* floating_window — daisyUI skin.
 *
 * daisyUI's `modal-box` is the right surface but the wrong behaviour: this window is draggable and
 * does not block the page, so the box is borrowed and the title bar — which daisyUI has nothing
 * for — is drawn as the drag handle it is, cursor included.
 */

/* Absolute, not fixed: the component clamps itself to its offset parent, so a fixed window escapes
 * the stage it is supposed to be dragged around inside and lands on the page instead. `modal-box`
 * brings a modal's width with it, which is far too wide for a panel that shares the page. */
.chelekom-floating-window {
  @apply <%= @d %>modal-box;

  position: absolute;
  width: calc(0.25rem * 52);
  max-width: 100%;
  z-index: 60;

  /* `modal-box` is drawn closed — scaled down and transparent — because inside a `modal` it is the
   * `modal-open` state that reveals it. This window is always on the page, so it has to undo that
   * or it never appears at all. */
  scale: 100%;
  opacity: 1;
  display: flex;
  flex-direction: column;
  padding: 0;
  overflow: hidden;
}

.chelekom-floating-window__handle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(0.25rem * 2);
  border-bottom: var(--border) solid color-mix(in oklab, var(--color-base-content) 12%, #0000);
  background-color: var(--color-base-200);
  padding: calc(0.25rem * 2) calc(0.25rem * 3);
  cursor: grab;
  user-select: none;
  font-weight: 600;
}

.chelekom-floating-window__handle:active {
  cursor: grabbing;
}

.chelekom-floating-window__body {
  flex: 1;
  overflow: auto;
  padding: calc(0.25rem * 4);
}
