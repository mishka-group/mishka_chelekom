/* table — daisyUI skin.
 *
 * This is the one component where daisyUI's stylesheet transfers almost intact: its `table` rules
 * target `th`, `td`, `thead`, `tbody` and `tr` — real elements, not class names — so applying
 * `table` to our root brings the whole grid with it, zebra striping, pinned rows and all.
 *
 * Only our own additions need painting: the visually-hidden caption, the sort button, and the
 * alignment attribute.
 */

.chelekom-table {
  @apply <%= @d %>table;
}

/* A table's name is for the reader that lands on it; showing it is the caller's choice. */
.chelekom-table__caption[data-hidden] {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border-width: 0;
}

.chelekom-table__caption:not([data-hidden]) {
  caption-side: top;
  padding-block: calc(0.25rem * 2);
  text-align: start;
  font-weight: 600;
}

.chelekom-table__sort {
  display: inline-flex;
  align-items: center;
  gap: calc(0.25rem * 1);
  cursor: pointer;
  font: inherit;
  color: inherit;
}

.chelekom-table__sort:hover {
  text-decoration-line: underline;
}

.chelekom-table__sort:focus-visible {
  outline: 2px solid currentcolor;
  outline-offset: 2px;
}

/* The arrow is drawn from the direction the server rendered, so it can never disagree with
 * `aria-sort` — they come from the same attribute. */
.chelekom-table__sort::after {
  content: "↕";
  opacity: 30%;
}

.chelekom-table__sort[data-dir="asc"]::after {
  content: "↑";
  opacity: 100%;
}

.chelekom-table__sort[data-dir="desc"]::after {
  content: "↓";
  opacity: 100%;
}

.chelekom-table__header[data-align="center"],
.chelekom-table__cell[data-align="center"] {
  text-align: center;
}

.chelekom-table__header[data-align="end"],
.chelekom-table__cell[data-align="end"] {
  text-align: end;
}

.chelekom-table__select {
  @apply <%= @d %>checkbox <%= @d %>checkbox-sm;
}

.chelekom-table__empty {
  text-align: center;
  padding-block: calc(0.25rem * 8);
  opacity: 60%;
}

/* daisyUI marks a highlighted row with the `active` class on the `<tr>`; ours is a state, so the
 * skin reads the attribute the component already sets. */
.chelekom-table__row[data-selected] {
  background-color: color-mix(in oklab, var(--color-base-content) 6%, transparent);
}
