/* scroll_area — daisyUI skin.
 *
 * daisyUI has no scroll area. The custom scrollbar is drawn from theme tokens and sized from the
 * `--scroll-area-thumb-*` variables the engine measures, so the thumb stays proportional to the
 * content rather than a fixed height.
 */

.chelekom-scroll_area {
  position: relative;
  overflow: hidden;
  color: var(--color-base-content);
}

.chelekom-scroll_area__viewport {
  height: 100%;
  width: 100%;
  overflow: auto;
  scrollbar-width: none;
}

.chelekom-scroll_area__viewport::-webkit-scrollbar {
  display: none;
}

.chelekom-scroll_area__scrollbar {
  position: absolute;
  display: flex;
  touch-action: none;
  user-select: none;
  padding: 2px;
  opacity: 0;
  transition: opacity 0.2s ease-out;
}

/* The bar appears while it is relevant — during a scroll, or while the pointer is over the area —
 * and stays out of the way otherwise. */
.chelekom-scroll_area[data-hovering] .chelekom-scroll_area__scrollbar,
.chelekom-scroll_area[data-scrolling] .chelekom-scroll_area__scrollbar {
  opacity: 1;
}

.chelekom-scroll_area__scrollbar[data-orientation="vertical"] {
  inset-block: 0;
  inset-inline-end: 0;
  width: calc(0.25rem * 2.5);
}

.chelekom-scroll_area__scrollbar[data-orientation="horizontal"] {
  inset-inline: 0;
  bottom: 0;
  flex-direction: column;
  height: calc(0.25rem * 2.5);
}

.chelekom-scroll_area__thumb {
  flex: 1;
  border-radius: calc(infinity * 1px);
  background-color: color-mix(in oklab, var(--color-base-content) 30%, transparent);
}

.chelekom-scroll_area__thumb:hover {
  background-color: color-mix(in oklab, var(--color-base-content) 45%, transparent);
}

.chelekom-scroll_area__corner {
  background-color: transparent;
}
