/* field — daisyUI skin (label + control + help/error, daisyUI's `label` and `validator-hint`). */

.chelekom-field {
  display: flex;
  flex-direction: column;
  gap: calc(0.25rem * 1);
  color: var(--color-base-content);
}

.chelekom-field__label {
  @apply <%= @d %>label;
  font-size: 0.875rem;
}

/* The control part is a WRAPPER around whatever the caller renders, not the input itself — so
 * daisyUI's `input` box goes on the control inside it. */
.chelekom-field__control {
  display: flex;
  flex-direction: column;
}

.chelekom-field__control > :is(input, select, textarea) {
  @apply <%= @d %>input;
  width: 100%;
}

.chelekom-field__description {
  font-size: 0.75rem;
  color: color-mix(in oklab, var(--color-base-content) 60%, transparent);
}

/* daisyUI's `validator-hint` is the message under an invalid control; ours is the error part, shown
 * off the `data-invalid` the field already sets rather than off `:user-invalid`. */
.chelekom-field__error {
  font-size: 0.75rem;
  color: var(--color-error);
}

.chelekom-field[data-invalid] .chelekom-field__control > :is(input, select, textarea) {
  --<%= @d %>input-color: var(--color-error);
}

.chelekom-field[data-valid] .chelekom-field__control > :is(input, select, textarea) {
  --<%= @d %>input-color: var(--color-success);
}

.chelekom-field[data-disabled] {
  opacity: 60%;
}
