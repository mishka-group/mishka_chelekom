/* toggle_group — daisyUI skin.
 *
 * daisyUI's equivalent is `join` wrapped around `btn`s: one strip, square inner corners, the
 * pressed one filled. `join` sets its radius variables on its *direct children* through `@scope`,
 * and our items are direct children, so the join is mirrored here rather than borrowed — the same
 * reasoning as the pagination, and for the same reason: the outer corners round, the inner ones do
 * not, and the one-pixel overlap stops adjacent borders doubling.
 *
 * Pressed keys off `data-pressed`, which the engine sets.
 */

.chelekom-toggle-group {
  display: inline-flex;
  align-items: stretch;
}

.chelekom-toggle-group[data-orientation="vertical"] {
  flex-direction: column;
}

.chelekom-toggle-group__item {
  @apply <%= @d %>btn;

  border-radius: 0;
}

.chelekom-toggle-group__item:first-child {
  border-start-start-radius: var(--radius-field);
  border-end-start-radius: var(--radius-field);
}

.chelekom-toggle-group__item:last-child {
  border-start-end-radius: var(--radius-field);
  border-end-end-radius: var(--radius-field);
}

.chelekom-toggle-group[data-orientation="vertical"] .chelekom-toggle-group__item:first-child {
  border-radius: var(--radius-field) var(--radius-field) 0 0;
}

.chelekom-toggle-group[data-orientation="vertical"] .chelekom-toggle-group__item:last-child {
  border-radius: 0 0 var(--radius-field) var(--radius-field);
}

.chelekom-toggle-group__item:not(:first-child) {
  margin-inline-start: calc(var(--border, 1px) * -1);
}

.chelekom-toggle-group[data-orientation="vertical"] .chelekom-toggle-group__item:not(:first-child) {
  margin-inline-start: 0;
  margin-block-start: calc(var(--border, 1px) * -1);
}

.chelekom-toggle-group__item[data-pressed] {
  @apply <%= @d %>btn-active;
}

.chelekom-toggle-group__item:focus-visible {
  z-index: 2;
}

.chelekom-toggle-group[data-disabled] .chelekom-toggle-group__item {
  @apply <%= @d %>btn-disabled;
}
