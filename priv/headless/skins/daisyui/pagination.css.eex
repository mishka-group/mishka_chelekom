/* pagination — daisyUI skin.
 *
 * daisyUI has no pagination component: its page shows `join` wrapped around hand-written `btn`s.
 * `join` sets its radius variables on its *direct children* through `@scope (&)`, and our controls
 * sit one level down inside `<li>` — keeping the list semantics costs the join, so the join is
 * mirrored here instead: square inner corners, rounded outer ones, and the one-pixel overlap that
 * stops adjacent borders doubling up.
 */

.chelekom-pagination__list {
  display: inline-flex;
  align-items: stretch;
}

.chelekom-pagination__control {
  @apply <%= @d %>btn;

  border-radius: 0;
}

.chelekom-pagination__item:first-child .chelekom-pagination__control {
  border-start-start-radius: var(--radius-field);
  border-end-start-radius: var(--radius-field);
}

.chelekom-pagination__item:last-child .chelekom-pagination__control {
  border-start-end-radius: var(--radius-field);
  border-end-end-radius: var(--radius-field);
}

.chelekom-pagination__item:not(:first-child) .chelekom-pagination__control {
  margin-inline-start: calc(var(--border, 1px) * -1);
}

/* A focused or hovered control has to sit above its neighbours or the overlap clips its ring. */
.chelekom-pagination__control:focus-visible {
  z-index: 2;
}

.chelekom-pagination__control:hover {
  z-index: 1;
}

/* The current page is a disabled button, so it must not look like the greyed-out edge controls —
 * daisyUI's active treatment is what marks it. */
.chelekom-pagination__control[aria-current="page"] {
  @apply <%= @d %>btn-active;

  pointer-events: none;
}

.chelekom-pagination__ellipsis {
  display: inline-flex;
  align-items: center;
  padding-inline: calc(0.25rem * 3);
  opacity: 60%;
  user-select: none;
}

/* The radio form: an `<input>` has no text content, so the number is drawn from `data-page`. The
 * accessible name stays on `aria-label`, which says "Page 3" rather than a bare digit. */
input.chelekom-pagination__control {
  appearance: none;
  cursor: pointer;
}

input.chelekom-pagination__control::after {
  content: attr(data-page);
}

input.chelekom-pagination__control:checked {
  @apply <%= @d %>btn-active;
}
