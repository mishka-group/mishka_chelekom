/* action_icon — daisyUI skin.
 *
 * daisyUI has no icon-button component: its own icon buttons are `btn btn-square` or
 * `btn btn-circle`, written by hand. Square is the default here because that is what an icon-only
 * button in a toolbar usually is; `btn-circle` still works when the caller wants it, and so does
 * every other `btn-*` modifier, because the root takes `btn` itself.
 */

.chelekom-action-icon {
  @apply <%= @d %>btn <%= @d %>btn-square;
}

.chelekom-action-icon[data-disabled] {
  @apply <%= @d %>btn-disabled;
}
