/* button — daisyUI skin (paints `btn`; every btn modifier works on the root). */

.chelekom-button {
  @apply <%= @d %>btn;
}

/* daisyUI keys the disabled look off `:disabled`, which an anchor cannot have — our link form uses
 * `aria-disabled` instead, so pair them up. */
.chelekom-button[aria-disabled="true"] {
  pointer-events: none;
  border-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
  background-color: color-mix(in oklab, var(--color-base-content) 10%, transparent);
  color: color-mix(in oklab, var(--color-base-content) 20%, transparent);
  box-shadow: none;
}

.chelekom-button__loader {
  display: inline-flex;
}

.chelekom-button__start-icon,
.chelekom-button__end-icon {
  display: inline-flex;
  flex-shrink: 0;
}
