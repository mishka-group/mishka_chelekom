/* mark — daisyUI skin.
 *
 * The same treatment as `highlight`, on the single-element version: a browser's default `<mark>` is
 * a fixed yellow that ignores the theme entirely, so it is replaced with the theme's own warning.
 */

.chelekom-mark {
  border-radius: calc(0.25rem * 0.5);
  padding-inline: calc(0.25rem * 0.5);
  background-color: color-mix(in oklab, var(--color-warning) 45%, transparent);
  color: inherit;
}
