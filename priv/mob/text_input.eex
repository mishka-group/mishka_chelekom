defmodule <%= @module %> do
  @moduledoc """
  Native Mob port of Mishka Chelekom's **headless Text Input** — a single- or
  multi-line field with the form events and the styling props the bridge reads.

  Chelekom's Mob set has no plain text input. `<%= @module_prefix_camel %>Field` labels and reports
  on a control; the masked, numeric, OTP, tags and select ports are their own
  widgets. This is the missing primitive: the caller owns the value, the
  placeholder and the events, and the component owns the `:text_field` node and
  the props the bridge reads.

  ## The value is controlled

  `value` is echoed back by the screen, and an echo of what the field already
  shows is a no-op: the caret does not move. To replace the text (clearing it
  after a submit, say), assign the new `value`. On Android the bridge adopts a
  value that differs from the field's text on each render the screen pushes;
  iOS adopts a changed value whenever the field isn't focused. There is no
  epoch to bump.

  ## Multiline

  `multiline: true` makes the field a paragraph three rows tall and keeps Return
  for a newline instead of submitting, so `on_submit` does not fire (on
  Android a `return_key` puts an action key back, and that key submits). An
  explicit `lines` sets the row count and wins over `multiline`; `lines: 1` is
  a single-line field.

  ## Prop names

  Mob's text field spells three of these props differently, so they are
  translated on the way to the node:

  * `keyboard_type` becomes `keyboard`, as a string (`:email` → `"email"`).
  * `font_family` becomes `font`.
  * `multiline: true` becomes `lines: 3`.

  Mob's own spellings, `keyboard` and `font`, are accepted too, and win when
  both are given.

  ## Leading and trailing nodes

  `leading` and `trailing` put a node on either side of the field, separated by
  `slot_gap`. The field keeps all of its own props; the wrapper is a
  `fill_width` `Row` with `align: :center` and nothing else, so the caller can
  draw the border and padding on an outer container exactly as it would around
  a bare field. With neither slot set, the node is the field itself — no
  wrapper, no extra row.

  ## Not ported

  * The web component's `field` struct, `name` and validity wiring — there is
    no Phoenix form on the device, and Mob text nodes carry no ARIA state.
    Report errors with `<%= @module_prefix_camel %>Field` around the control instead.
  * `start_section` / `end_section` — the bridge's field is one control, with
    no inline section nodes inside its border.
  * `*_class` and the DOM attributes.

  ## Props

  | Prop | Values | Default | Meaning |
  |------|--------|---------|---------|
  | `value` | string | unset | The current text. |
  | `placeholder` | string | unset | Hint shown while empty. |
  | `multiline` | boolean | `false` | A paragraph field three rows tall (`lines: 3`). |
  | `lines` | integer | unset | Rows; above 1 is a multi-line field. Wins over `multiline`. |
  | `max_length` | integer | unset | Rejects edits that would exceed it. |
  | `secure` | boolean | `false` | Masks the text. |
  | `keyboard_type` / `keyboard` | `:default` `:email` `:number` `:phone`, atom or string | unset | Keyboard variant, sent as `keyboard`. Mob also reads `"decimal"` and `"url"`. |
  | `return_key` | string | unset | The keyboard's return label. |
  | `caret` | `"end"` | unset | Pin the insertion point to the end. |
  | `underline` | boolean | bridge default | Material's indicator line (Android). |
  | `text_size` | text token / number | `:base` | Typed text and placeholder. |
  | `text_color` / `placeholder_color` | color token / ARGB int | `:on_surface` / `:muted` | Inks. |
  | `font_family` (or `font`) / `font_weight` / `letter_spacing` / `text_align` | as a Text | unset | Type of the field; `font_family` is sent as `font`. |
  | `background` | color token / ARGB int | `:surface_raised` | Field fill. |
  | `border_color` / `border_width` | color / number | `:border` / unset | Outline. |
  | `corner_radius` | radius token / number | `:radius_sm` | Corners. |
  | `padding` / `padding_top` / `padding_right` / `padding_bottom` / `padding_left` | spacing token / number | `:space_sm` | Inner padding. |
  | `width` / `height` / `fill_width` | number / boolean | unset | Size. |
  | `leading` / `trailing` | node or list of nodes | unset | Content beside the field. |
  | `slot_gap` | number | `8` | Space between a slot and the field. |
  | `id` / `accessibility_id` | string | unset | Native testTag. |
  | `on_change` / `on_submit` / `on_focus` / `on_blur` | event tag | — | `{:change, tag, value}`, `{:submit, tag}`, `{:focus, tag}`, `{:blur, tag}`. |

  **Documentation:** https://mishka.tools/chelekom/docs/mob/text-input
  """

  import Mob.Sigil

  alias <%= @namespace %>.Event

  # Forwarded as they are. `keyboard_type` / `keyboard`, `font_family` / `font`
  # and `multiline` / `lines` are translated by `translated/1`.
  @props ~w(
    value placeholder max_length secure enabled disabled return_key caret
    underline text_size text_color placeholder_color font_weight
    letter_spacing text_align background border_color border_width
    corner_radius padding padding_top padding_right padding_bottom
    padding_left width height fill_width accessibility_id id
  )a

  @multiline_rows 3

  @events ~w(on_change on_submit on_focus on_blur)a

  @doc "Composite expander (`<<%= @module_prefix_camel %>TextInput />`). Children are ignored."
  @spec expand(map(), [map()], map()) :: map()
  def expand(props, _children, _ctx), do: <%= @component_prefix %>text_input(props)

  @doc """
  The text-input node.

      <%= @component_prefix %>text_input(value: "Dune", placeholder: "Title", on_change: :typed)

      <%= @component_prefix %>text_input(%{placeholder: "Search", leading: glyph, trailing: glyph},
                 [])
  """
  @spec <%= @component_prefix %>text_input(map() | keyword()) :: map()
  def <%= @component_prefix %>text_input(props \\ %{}) do
    props = Map.new(props)
    leading = Map.get(props, :leading)
    trailing = Map.get(props, :trailing)

    if leading == nil and trailing == nil do
      field_node(props)
    else
      # The field takes the space the slots leave. Without a weight a
      # fill-width field inside a Row measures zero when it is empty, and the
      # slots then sit against each other.
      field = field_node(props, %{weight: 1.0})
      gap = Map.get(props, :slot_gap) || 8

      children =
        [leading, spacer(leading, gap), field, spacer(trailing, gap), trailing]
        |> Enum.reject(&is_nil/1)

      ~MOB"""
      <Row fill_width={true} align={:center}>
        {children}
      </Row>
      """
    end
  end

  defp field_node(props, extra \\ %{}) do
    forwarded =
      props
      |> Map.take(@props)
      |> Map.merge(translated(props))
      |> Enum.reject(fn {_key, value} -> is_nil(value) end)
      |> Map.new()
      |> Map.merge(extra)

    %{~MOB(<TextField />) | props: Map.merge(forwarded, events(props))}
  end

  # Upstream's prop names to the ones mob's text field reads. See "Prop names".
  defp translated(props) do
    %{
      keyboard: keyboard(Map.get(props, :keyboard) || Map.get(props, :keyboard_type)),
      font: Map.get(props, :font) || Map.get(props, :font_family),
      lines: Map.get(props, :lines) || multiline_rows(Map.get(props, :multiline))
    }
  end

  defp keyboard(nil), do: nil
  defp keyboard(keyboard), do: to_string(keyboard)

  defp multiline_rows(multiline) when multiline in [nil, false, "false"], do: nil
  defp multiline_rows(_multiline), do: @multiline_rows

  defp spacer(nil, _gap), do: nil

  defp spacer(_slot, gap) do
    assigns = %{gap: gap}
    ~MOB"<Spacer size={@gap} />"
  end

  defp events(props) do
    Enum.reduce(@events, %{}, fn key, acc ->
      case Event.handler(Map.get(props, key)) do
        nil -> acc
        handler -> Map.put(acc, key, handler)
      end
    end)
  end
end
