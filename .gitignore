# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
mishka_chelekom-*.tar

# Temporary files, for example, from tests.
/tmp/

# Local
.DS_Store
/.zed/
/.claude/launch.json
.iex.exs
/assets
/config
.elixir-tools
.elixir_ls

# `mix mishka.ui.export <dir> --cms --name <kit>` writes to `<dir>/<kit>.json` and takes no output
# path, so exporting `priv/components` leaves an 11 MB bundle there. It is a build artifact — every
# export and every export-suite run rewrites it in full, which buries real diffs and lets it drift
# from the copy that ships. The copy that ships is `priv/cms_ui_kits/<kit>.json`, which IS tracked.
# `MishkaChelekom.CmsBundle.Location` is what the readers ask, so a clone that has never exported
# still finds a bundle.
/priv/components/*.json
